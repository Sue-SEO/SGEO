# 复制这个文件为 .env.local，然后填入你自己的真实值
# .env.local 不会被提交到 GitHub（已在 .gitignore 里排除），放心填真实密钥

# Supabase 项目设置 -> API Keys 页面能找到
NEXT_PUBLIC_SUPABASE_URL=https://你的项目id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的Publishable_key

# Anthropic API 密钥（console.anthropic.com 申请）
# 注意：这个密钥没有 NEXT_PUBLIC_ 前缀，只会在服务器端使用，不会暴露给浏览器
ANTHROPIC_API_KEY=你的sk-ant-开头的密钥

# Google Search Console 数据拉取（服务账号方式）
# 邮箱和私钥来自 Google Cloud Console 生成的服务账号JSON密钥文件
GOOGLE_SERVICE_ACCOUNT_EMAIL=你的服务账号邮箱@项目id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 在GSC里验证过的资源网址，URL prefix类型的要带上结尾斜杠
GSC_SITE_URL=https://sgeo-one.vercel.app/
# 自己随便设一个随机字符串，用来保护/api/gsc-sync这个接口不被陌生人随便调用
CRON_SECRET=随便设一串你自己记得住的随机字符串
